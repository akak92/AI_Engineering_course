# API Keys de los proveedores de LLM soportados por el pipeline.
# Copia este archivo a ".env" (que NO debe subirse al repositorio) y
# completa los valores con tus propias credenciales.

OPENAI_API_KEY=sk-tu-api-key-de-openai
ANTHROPIC_API_KEY=sk-ant-tu-api-key-de-anthropic

# Proveedor a usar por defecto: "openai" o "anthropic".
LLM_PROVIDER=openai
