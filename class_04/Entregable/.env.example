PINECONE_API_KEY=pcsk_...
OPENAI_API_KEY=sk-...

# --- Infraestructura de Pinecone (pinecone_setup.py) ---
INDEX_NAME=rag-langchain-docs
EMBEDDING_DIMENSION=1536
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Ingesta (ingest.py / chunking.py) ---
PINECONE_NAMESPACE=langchain-docs
EMBEDDING_MODEL=text-embedding-3-small
INGEST_BATCH_SIZE=100
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80

# --- Recuperador híbrido (rag_system.py) ---
RAG_TOP_K=5
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
